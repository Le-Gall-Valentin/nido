# Optional — nothing here is required. Copy this file to .env, next to compose.yaml, to change something.

# The version to run. Pin it (for example 0.12.0) so that `docker compose pull` never moves you to a
# new version by surprise; `latest` follows every release.
# NIDO_VERSION=latest

# The port Nido answers on, and the address it listens on.
# NIDO_PORT=8080
# NIDO_LISTEN=0.0.0.0

# HTTPS with automatic certificates (Let's Encrypt). Needs a domain name pointing to this machine,
# and ports 80 and 443 open. Uncomment the three lines: the last one makes port 8080 reachable by
# Caddy alone.
# COMPOSE_PROFILES=https
# NIDO_DOMAIN=nido.example.com
# NIDO_LISTEN=127.0.0.1
