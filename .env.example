# ============================================================
# NIDO API — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit your actual .env file.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
NIDO_DB_URL=jdbc:postgresql://localhost:5432/nido
NIDO_DB_USER=NIDO
NIDO_DB_PASSWORD=NIDO

# ── JWT Access Token ─────────────────────────────────────────
# Secret key for signing access tokens.
# IMPORTANT: must be a cryptographically random value of at least 256 bits (32 bytes).
# Generate with: openssl rand -base64 32
# WARNING: a predictable value (e.g. words, repeated chars) weakens token security.
NIDO_JWT_SECRET=<generate with: openssl rand -base64 32>
# Access token lifetime in minutes (default: 15).
NIDO_JWT_EXPIRY_MINUTES=15

# ── Refresh Token ────────────────────────────────────────────
# Opaque refresh token lifetime in days (default: 30).
NIDO_REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Cookies ──────────────────────────────────────────────────
# Set to false for local HTTP development; defaults to true in production (HTTPS).
NIDO_COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
NIDO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database Seeder ──────────────────────────────────────────
# Initial admin account created on first run.
NIDO_SEED_USERNAME=admin
NIDO_SEED_EMAIL=admin@NIDO.local
NIDO_SEED_PASSWORD=changeme

# ── Redis ────────────────────────────────────────────────────
# Required at startup — the application will not start if Redis is unavailable.
# Format: redis://[password@]host:port[/db-index]
#         redis://localhost:6379        (no auth)
#         redis://:password@host:6379   (with password)
#         rediss://host:6380            (TLS)
NIDO_REDIS_URL=redis://localhost:6379

# ── Sonde de santé ───────────────────────────────────────────
# Port du endpoint /actuator/health, servi séparément du port applicatif et jamais publié :
# la sonde du conteneur l'atteint en loopback, le reverse proxy n'y a aucune route. À changer
# seulement s'il entre en conflit avec autre chose sur la machine.
NIDO_MANAGEMENT_PORT=8081

# ── Swagger UI ───────────────────────────────────────────────
# Serves Swagger UI, and the OpenAPI document at /api/docs. The document requires being
# logged in — it sits under /api, which the security config authenticates and which is also
# the only prefix the session cookie is sent to. Enabling this therefore does not publish the
# API, but there is still no reason to turn it on in production.
SWAGGER_ENABLED=true

# ── Encryption ─────────────────────────────────────────
# IMPORTANT: must be a cryptographically random value of at least 256 bits (32 bytes).
# Generate with: openssl rand -base64 32
NIDO_ENCRYPTION_SECRET=<generate with: openssl rand -base64 32>

# ── Mail (optional) ──────────────────────────────────────────
# Leave NIDO_SMTP_HOST empty and Nido sends no mail at all: the "forgot password" link is not
# shown and nothing is ever queued. Fill it in and NIDO_MAIL_FROM and NIDO_APP_URL become
# required — the application refuses to start without them.
NIDO_SMTP_HOST=
# NIDO_SMTP_PORT=587
# starttls (port 587, encryption required), tls (port 465) or none (local Mailpit only).
# NIDO_SMTP_SECURITY=starttls
# NIDO_SMTP_USERNAME=
# NIDO_SMTP_PASSWORD=
# The sender, with its display name. Its domain needs SPF, DKIM and DMARC records for the SMTP
# provider, or the mails land in spam.
# NIDO_MAIL_FROM=Nido <nido@example.com>
# The public address of the app, used to build the links in mails — never taken from a request.
# NIDO_APP_URL=https://nido.example.com
#
# Local development with Mailpit (docker compose --profile mail up; mails at http://localhost:8025):
# NIDO_SMTP_HOST=localhost
# NIDO_SMTP_PORT=1025
# NIDO_SMTP_SECURITY=none
# NIDO_MAIL_FROM=Nido <nido@localhost>
# NIDO_APP_URL=http://localhost:5173
