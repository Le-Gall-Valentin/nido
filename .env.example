# ============================================================
# NIDO API — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit your actual .env file.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
NIDO_DB_URL=jdbc:postgresql://localhost:5432/nido
NIDO_DB_USER=NIDO
NIDO_DB_PASSWORD=NIDO

# ── JWT Access Token ─────────────────────────────────────────
# Secret key for signing access tokens.
# IMPORTANT: must be a cryptographically random value of at least 256 bits (32 bytes).
# Generate with: openssl rand -base64 32
# WARNING: a predictable value (e.g. words, repeated chars) weakens token security.
NIDO_JWT_SECRET=<generate with: openssl rand -base64 32>
# Access token lifetime in minutes (default: 15).
NIDO_JWT_EXPIRY_MINUTES=15

# ── Refresh Token ────────────────────────────────────────────
# Opaque refresh token lifetime in days (default: 30).
NIDO_REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Cookies ──────────────────────────────────────────────────
# Set to false for local HTTP development; defaults to true in production (HTTPS).
NIDO_COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
NIDO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database Seeder ──────────────────────────────────────────
# Initial admin account created on first run.
NIDO_SEED_USERNAME=admin
NIDO_SEED_EMAIL=admin@NIDO.local
NIDO_SEED_PASSWORD=changeme

# ── Redis ────────────────────────────────────────────────────
# Required at startup — the application will not start if Redis is unavailable.
# Format: redis://[password@]host:port[/db-index]
#         redis://localhost:6379        (no auth)
#         redis://:password@host:6379   (with password)
#         rediss://host:6380            (TLS)
NIDO_REDIS_URL=redis://localhost:6379

# ── Swagger UI ───────────────────────────────────────────────
# Disabled by default in production; enable locally for API exploration.
SWAGGER_ENABLED=true

# ── Encryption ─────────────────────────────────────────
# IMPORTANT: must be a cryptographically random value of at least 256 bits (32 bytes).
# Generate with: openssl rand -base64 32
NIDO_ENCRYPTION_SECRET=<generate with: openssl rand -base64 32>

